@using Practice.Models
@model  LoginModel

@{
    Layout = null;
}
@Styles.Render("~/Content/css")

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title></title>
</head>
<body class="">
    <div>
        <h1 class="Titulo text-center my">Inicio sesion</h1>
    </div>
    <div class="formu ">
        @using (Html.BeginForm("LoginInicial", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(true)
            <div class="form-group ">
                @Html.LabelFor(m => m.Email, new { @class = "mb-2 mt-4 " })
                <div class="col-md-10">

                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control  " })

                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group ">
                @Html.LabelFor(m => m.Password, new { @class = "mb-2 mt-4 " })
                <div class="col-md-10 ">
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group my-2 d-flex  justify-content-center">
                <div class="">
                    <input type="submit" value="Ingresar" class="btn btn-default btn-success" />
                </div>
            </div>
        }
    </div>
</body>
</html>
